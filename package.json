{
	"name": "mothmark",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "phase run 'next dev'",
		"db:up": "\"$(brew --prefix postgresql@17)/bin/pg_ctl\" -D \"$(brew --prefix)/var/postgresql@17\" -l \"$(brew --prefix)/var/log/postgresql@17.log\" start",
		"db:down": "\"$(brew --prefix postgresql@17)/bin/pg_ctl\" -D \"$(brew --prefix)/var/postgresql@17\" stop",
		"db:create": "\"$(brew --prefix postgresql@17)/bin/createdb\" mothmark",
		"db:reset": "\"$(brew --prefix postgresql@17)/bin/dropdb\" --if-exists --force mothmark && \"$(brew --prefix postgresql@17)/bin/createdb\" mothmark && DATABASE_URL=postgresql://localhost/mothmark DATABASE_SSL=false pnpm migrate",
		"db:migrate": "phase run 'DATABASE_URL=\"${DATABASE_MIGRATION_URL:-$DATABASE_URL}\" pnpm migrate'",
		"db:make": "node --import tsx db/createMigration.ts",
		"migrate": "node --import tsx db/migrate.ts",
		"release:migrate": "node --import tsx scripts/releaseMigrate.ts",
		"storage:contract": "node --import tsx scripts/updateStorageContract.ts",
		"cleanup:anonymous": "node --conditions=react-server --import tsx scripts/anonymousCleanup.ts",
		"admin:create": "phase run 'node --conditions=react-server --import tsx scripts/adminCreate.ts'",
		"admin:recover": "phase run 'node --conditions=react-server --import tsx scripts/adminRecover.ts'",
		"admin:create:prod": "phase run --env production 'node --conditions=react-server --import tsx scripts/adminCreate.ts'",
		"auth:benchmark": "node --conditions=react-server --import tsx scripts/benchmarkPasswordHash.ts",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "husky",
		"test": "jest",
		"test:all": "pnpm test && pnpm test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"ts-check": "npx tsc --noEmit"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,scss,md,mdx}": "prettier --write"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.0.2",
		"@types/jest": "^30.0.0",
		"@vercel/analytics": "^2.0.1",
		"immer": "^11.1.15",
		"knex": "^3.3.0",
		"lucide-react": "^1.23.0",
		"next": "16.2.9",
		"pg": "^8.22.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-hotkeys-hook": "^5.3.3",
		"sass": "^1.101.0",
		"save-dev": "0.0.1-security",
		"server-only": "^0.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^20",
		"@types/pg": "^8.20.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.2.9",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"lint-staged": "^17.0.8",
		"prettier": "^3.9.4",
		"tailwindcss": "^4",
		"ts-node": "^10.9.2",
		"tsx": "^4.23.1",
		"typescript": "^5",
		"wrangler": "^4.110.0"
	}
}

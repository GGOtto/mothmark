{
	"id": {"type": "command", "id": "present-item"},
	"name": "Give or show",
	"enabled": true,
	"showInHelp": true,
	"helpPattern": "give <item> to <item>",
	"helpDescription": "Give, offer, or show a carried item to another reachable item.",
	"patterns": [
		{
			"blocks": [
				{
					"id": {"type": "command-block", "id": "present-action"},
					"type": "choice",
					"role": "action",
					"choices": [
						{"value": "give", "label": "give", "matches": ["give", "offer", "hand", "present"]},
						{"value": "show", "label": "show", "matches": ["show", "display", "reveal"]}
					]
				},
				{
					"id": {"type": "command-block", "id": "present-item"},
					"type": "target",
					"role": "direct-object",
					"entityTypes": ["item"],
					"entityIds": [],
					"tags": ["presentable"],
					"tagMode": "all",
					"source": "reachable",
					"extraAliases": []
				},
				{
					"id": {"type": "command-block", "id": "present-relation"},
					"type": "relation",
					"relation": "to",
					"aliasMode": "extend",
					"aliases": ["for"],
					"role": "relation"
				},
				{
					"id": {"type": "command-block", "id": "present-target"},
					"type": "target",
					"role": "indirect-object",
					"entityTypes": ["item"],
					"entityIds": [],
					"tags": [],
					"tagMode": "all",
					"source": "reachable",
					"extraAliases": []
				}
			]
		}
	],
	"scope": {"scope": "global"},
	"priority": 1,
	"fallbacks": [
		{
			"blockId": {"type": "command-block", "id": "present-action"},
			"behavior": {
				"id": {"type": "condition-branch", "id": "present-action-fallback"},
				"always": {
					"name": "Cannot resolve action",
					"id": {"type": "effect", "id": "present-action-fallback-effects"},
					"type": "group",
					"effects": [{"type": "message", "operation": "show", "message": "You can't do that."}],
					"allowMultipleUsesInWorld": true
				}
			}
		},
		{
			"blockId": {"type": "command-block", "id": "present-item"},
			"behavior": {
				"id": {"type": "condition-branch", "id": "present-item-fallback"},
				"always": {
					"name": "Cannot resolve item",
					"id": {"type": "effect", "id": "present-item-fallback-effects"},
					"type": "group",
					"effects": [
						{"type": "message", "operation": "show", "message": "You can't give or show that."}
					],
					"allowMultipleUsesInWorld": true
				}
			}
		},
		{
			"blockId": {"type": "command-block", "id": "present-target"},
			"behavior": {
				"id": {"type": "condition-branch", "id": "present-target-fallback"},
				"always": {
					"name": "Cannot resolve target",
					"id": {"type": "effect", "id": "present-target-fallback-effects"},
					"type": "group",
					"effects": [
						{
							"type": "message",
							"operation": "show",
							"message": "You can't see anyone or anything like that."
						}
					],
					"allowMultipleUsesInWorld": true
				}
			}
		}
	],
	"behavior": {
		"id": {"type": "condition-branch", "id": "present-branch"},
		"always": {
			"name": "Give or show",
			"id": {"type": "effect", "id": "present-effects"},
			"type": "group",
			"effects": [
				{
					"type": "player",
					"operation": "perform-item-action",
					"action": "give",
					"itemId": {"type": "item", "id": "present-item-value"},
					"targetItemId": {"type": "item", "id": "present-target-value"},
					"commandVariables": [
						{"blockId": {"type": "command-block", "id": "present-action"}, "field": "action"},
						{"blockId": {"type": "command-block", "id": "present-item"}, "field": "itemId"},
						{"blockId": {"type": "command-block", "id": "present-target"}, "field": "targetItemId"}
					]
				}
			],
			"allowMultipleUsesInWorld": true
		}
	}
}

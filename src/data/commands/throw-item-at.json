{
	"id": {"type": "command", "id": "throw-item-at"},
	"name": "Throw at",
	"enabled": true,
	"showInHelp": false,
	"helpPattern": "throw <item> at <item>",
	"helpDescription": "Throw a carried item at another reachable item.",
	"patterns": [
		{
			"blocks": [
				{
					"id": {"type": "command-block", "id": "throw-at-action"},
					"type": "choice",
					"role": "action",
					"choices": [
						{"value": "throw", "label": "throw", "matches": ["throw", "toss", "hurl", "fling", "chuck"]}
					]
				},
				{
					"id": {"type": "command-block", "id": "throw-at-item"},
					"type": "target",
					"role": "direct-object",
					"entityTypes": ["item"],
					"entityIds": [],
					"tags": ["throwable"],
					"tagMode": "all",
					"source": "reachable",
					"extraAliases": []
				},
				{
					"id": {"type": "command-block", "id": "throw-at-relation"},
					"type": "relation",
					"relation": "at",
					"aliasMode": "extend",
					"aliases": ["toward", "towards"],
					"role": "relation"
				},
				{
					"id": {"type": "command-block", "id": "throw-at-target"},
					"type": "target",
					"role": "indirect-object",
					"entityTypes": ["item"],
					"entityIds": [],
					"tags": [],
					"tagMode": "all",
					"source": "reachable",
					"extraAliases": []
				}
			]
		}
	],
	"scope": {"scope": "global"},
	"priority": 1,
	"fallbacks": [
		{
			"blockId": {"type": "command-block", "id": "throw-at-action"},
			"behavior": {
				"id": {"type": "condition-branch", "id": "throw-at-action-fallback"},
				"always": {
					"name": "Cannot resolve action",
					"id": {"type": "effect", "id": "throw-at-action-fallback-effects"},
					"type": "group",
					"effects": [{"type": "message", "operation": "show", "message": "You can't do that."}],
					"allowMultipleUsesInWorld": true
				}
			}
		},
		{
			"blockId": {"type": "command-block", "id": "throw-at-item"},
			"behavior": {
				"id": {"type": "condition-branch", "id": "throw-at-item-fallback"},
				"always": {
					"name": "Cannot resolve item",
					"id": {"type": "effect", "id": "throw-at-item-fallback-effects"},
					"type": "group",
					"effects": [{"type": "message", "operation": "show", "message": "You can't throw that."}],
					"allowMultipleUsesInWorld": true
				}
			}
		},
		{
			"blockId": {"type": "command-block", "id": "throw-at-target"},
			"behavior": {
				"id": {"type": "condition-branch", "id": "throw-at-target-fallback"},
				"always": {
					"name": "Cannot resolve target",
					"id": {"type": "effect", "id": "throw-at-target-fallback-effects"},
					"type": "group",
					"effects": [{"type": "message", "operation": "show", "message": "You can't see that target."}],
					"allowMultipleUsesInWorld": true
				}
			}
		}
	],
	"behavior": {
		"id": {"type": "condition-branch", "id": "throw-at-branch"},
		"always": {
			"name": "Throw at",
			"id": {"type": "effect", "id": "throw-at-effects"},
			"type": "group",
			"effects": [
				{
					"type": "player",
					"operation": "perform-item-action",
					"action": "throw",
					"itemId": {"type": "item", "id": "throw-at-item-value"},
					"targetItemId": {"type": "item", "id": "throw-at-target-value"},
					"commandVariables": [
						{"blockId": {"type": "command-block", "id": "throw-at-action"}, "field": "action"},
						{"blockId": {"type": "command-block", "id": "throw-at-item"}, "field": "itemId"},
						{"blockId": {"type": "command-block", "id": "throw-at-target"}, "field": "targetItemId"}
					]
				}
			],
			"allowMultipleUsesInWorld": true
		}
	}
}
